{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAIL",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#sail-functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.sail",
          "begin": "--",
          "end": "$",
          "patterns": []
        },
        {
          "name": "comment.block.sail",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sail",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sail",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sail",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sail",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sail",
          "match": "\\b(\\d+\\.?\\d*|\\.\\d+)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sail",
          "match": "\\b(if|then|else|end|true|false|null|and|or|not)\\b"
        },
        {
          "name": "keyword.other.sail",
          "match": "\\b(local|def|var|function|return)\\b"
        }
      ]
    },
    "sail-functions": {
      "patterns": [
        {
          "name": "support.function.sail",
          "match": "\\b(a![a-zA-Z]+)\\b"
        },
        {
          "name": "support.function.builtin.sail",
          "match": "\\b(type|value|displayValue|disabled|refreshOnChange|required|readOnly|charData|mergeAnsiOutput)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.sail",
          "match": "\\b(local|variable|var)\\b"
        },
        {
          "name": "variable.other.sail",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sail",
          "match": "(\\+|-|\\*|/|%|=|==|!=|<|>|<=|>=|&&|\\|\\||!)"
        }
      ]
    }
  },
  "scopeName": "source.sail"
}
